# Recordings and videos, gathered in one folder on 14 Sep 2026 - too large for GitHub (some
# over 4GB, and GitHub hard-rejects any file over 100MB). None are on the live server yet: they
# have to be uploaded separately, never through git.
assets/videos/

# Raw slide source files - only the JPG previews in assets/img/slides/previews/ are
# actually used on the site; the .pptx originals are large working files.
assets/img/slides/*.pptx

# Runtime-generated member uploads (profile photos, payment proofs). User data, not code -
# also likely contains PII that shouldn't sit in git history.
resok-portal/uploads/

# Real secrets belong in config.local.php on the server (gitignored, never pulled/overwritten)
# or in hosting-panel environment variables - never in a committed file.
resok-portal/public/api/config.local.php
resok-portal/server/.env

# One-off admin scripts with real member data baked in (names, emails, unredeemed KMPDC
# tokens) - uploaded to the server by hand and deleted after running, never through git.
# Narrower than seed-past-events.sql's own pattern would suggest: that file carries no PII
# and stays tracked, so this lists the real-data ones by name rather than a broad seed-*.
resok-portal/public/api/cron/seed-*.php
resok-portal/public/api/cron/debug-config.php
resok-portal/server/seed-*.php
resok-portal/server/seed-pleural-workshop.sql

# Node dependencies (the Node backend is unused in production, but just in case)
resok-portal/node_modules/

# OS / editor / Office cruft
.DS_Store
Thumbs.db
desktop.ini
*.log
~$*
*.crdownload

# Local preview copies of gated pages (served from the repo root so relative
# asset paths resolve). Throwaway - never deploy these, they bypass the gate.
_preview-*.html

# Local one-off setup scripts
_git_setup_step1.ps1
_git_push_step2.ps1
_git_push_step3.ps1
_git_push_chunked.ps1
_batch_files.txt
_git_code_only.ps1
_push_compressed_images.ps1


# Local developer tooling. PHPStan and friends are installed with composer on the dev
# machine only - the shared host has no composer and never needs them.
/vendor/
/.phpunit.cache/
composer.lock
