DirectoryIndex index.html

# NOTE: previously had `AddType application/x-httpd-php .html` here to let
# partials/header.php etc. be included via <?php ?> in the 7 converted marketing
# pages. Removed - on this host it just labeled .html files with a MIME type
# browsers can't render (forcing downloads) WITHOUT actually invoking PHP,
# breaking every .html page site-wide (portal included, since this .htaccess's
# rules cascade into subdirectories). Do not re-add without first confirming
# the exact handler name this host's control panel documents for "run .html as
# PHP" (e.g. AddHandler application/x-httpd-php82 .html, version-specific).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host - must stay first, before anything that gates on a session. The portal's
  # resok_token cookie is host-only (issueAuthCookie sets no domain attribute), so a session
  # started on www.resok.org is not sent to resok.org and vice versa: a member who logs in on
  # one host and then follows a link carrying the other - a search result, the sitemap, an
  # emailed portal link - is silently signed out and bounced to login, which reads as the
  # gate breaking at random. www is canonical everywhere else (portal_base_url in the API
  # config, sitemap.xml, every <link rel="canonical">), so send the bare domain there.
  RewriteCond %{HTTP_HOST} ^resok\.org$ [NC]
  RewriteRule ^(.*)$ https://www.resok.org/$1 [R=301,L]

  # Still-under-construction pages: block access entirely (any URL form - with/without
  # .html, with/without trailing slash) and bounce to Coming Soon. 302 (temporary) since
  # these will be real pages again once finished - don't want this cached as permanent.
  RewriteRule ^(conferences|projects|workshops-and-training|sponsors|blog|knowledge|guidelines|patient-resources)(\.html)?/?$ /coming-soon.html [R=302,L]

  # Members-only pages. Each one moved to private/<name>.html (blocked by private/.htaccess)
  # and is emitted only by its <name>.php wrapper, which verifies the portal's resok_token
  # cookie and the member's status via member-gate.php. Internal rewrites, not redirects, so
  # the public URLs are unchanged. Old /<name>.html links hit the canonical rule below first
  # and 301 to /<name>, which lands here.
  #
  # workshops-and-training is listed here too, but the coming-soon rule above matches first
  # and wins while that page is unfinished - the gate only takes effect once it is dropped
  # from that list.
  RewriteRule ^learning/?$ learning.php [L]
  RewriteRule ^media-learning/?$ media-learning.php [L]
  RewriteRule ^assemblies/?$ assemblies.php [L]
  RewriteRule ^research/?$ research.php [L]
  RewriteRule ^publication/?$ publication.php [L]
  RewriteRule ^workshops-and-training/?$ workshops-and-training.php [L]

  # Belt-and-braces with private/.htaccess, in case this host ever ignores overrides in
  # subdirectories: nothing under /private/ is ever served over HTTP. learning.php reads
  # those files off disk, so this does not affect it.
  RewriteRule ^private/ - [F]

  # Canonical URLs: /about.html -> /about and /folder/index.html -> /folder/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # Serve extensionless URLs from their .html files.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

Options -Indexes

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/rss+xml application/json application/javascript text/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>
