# Archival recordings/videos - not served by any page, too large for GitHub (some >4GB,
# GitHub hard-rejects any file over 100MB). Untouched on the live server; not managed here.
assets/img/Zoom Recordings/
assets/img/recordings/

# Raw slide source files - only the JPG previews in assets/img/slides/previews/ are
# actually used on the site; the .pptx originals are large working files.
assets/img/slides/*.pptx

# Runtime-generated member uploads (profile photos, payment proofs). User data, not code -
# also likely contains PII that shouldn't sit in git history.
resok-portal/uploads/

# Real secrets belong in config.local.php on the server (gitignored, never pulled/overwritten)
# or in hosting-panel environment variables - never in a committed file.
resok-portal/public/api/config.local.php
resok-portal/server/.env

# Node dependencies (the Node backend is unused in production, but just in case)
resok-portal/node_modules/

# OS / editor / Office cruft
.DS_Store
Thumbs.db
desktop.ini
*.log
~$*
*.crdownload

# Local one-off setup scripts
_git_setup_step1.ps1
_git_push_step2.ps1
_git_push_step3.ps1
_git_push_chunked.ps1
_batch_files.txt
_git_code_only.ps1
_push_compressed_images.ps1

